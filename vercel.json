{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/app/lab-boot",
      "destination": "/api/lab-boot"
    },
    {
      "source": "/verify",
      "destination": "/app/certificate"
    },
    {
      "source": "/verify/:code",
      "destination": "/app/certificate"
    }
  ]
}
